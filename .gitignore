# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output (don’t commit build artifacts)
dist/

# Env files (keep secrets out of git)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# If you keep an example env, DO commit it:
# !.env.example

# TypeScript
*.tsbuildinfo

# Testing/coverage
coverage/
.vitest/
*.lcov

# OS junk
.DS_Store
Thumbs.db

# IDE/editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.swp

# Storybook (if you use it)
.storybook-out/
out/
storybook-static/

# Optional: Tailwind/JIT cache
# (usually outside repo, but safe to ignore if present)
.tailwindcache/

# Optional: local tooling
.eslintcache
